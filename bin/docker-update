#!/bin/bash

version="$1"

if [[ -z "$version" ]]; then
    echo "version is required"
    exit 1
fi

# Server
docker pull ghcr.io/capsa-gg/capsa-server:latest
docker tag ghcr.io/capsa-gg/capsa-server:latest "ghcr.io/capsa-gg/capsa-server:$version"
docker push "ghcr.io/capsa-gg/capsa-server:$version"

# Web
docker pull ghcr.io/capsa-gg/capsa-web:latest
docker tag ghcr.io/capsa-gg/capsa-web:latest "ghcr.io/capsa-gg/capsa-web:$version"
docker push "ghcr.io/capsa-gg/capsa-web:$version"
