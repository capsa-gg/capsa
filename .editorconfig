root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[Makefile]
indent_style = tab
indent_size = 8

[{go.mod,go.sum,*.go,.gitmodules}]
indent_style = tab

[*.{yml,yaml,tpl,json,jsonc}]
indent_size = 2

[*.{bat,ps1,cmd}]
end_of_line = crlf