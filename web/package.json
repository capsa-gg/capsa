{
  "name": "capsa-webpanel",
  "version": "0.3.0",
  "description": "Webapp for Project Capsa, an Unreal Engine log solution",
  "author": "Luciano Nooijen <luciano@lucianonooijen.com>",
  "license": "AGPL-3.0-only",
  "private": true,
  "engines": {
    "node": ">=22.10.0",
    "npm": ">=10.9.0"
  },
  "nextBundleAnalysis": {
    "budget": 1000000,
    "budgetPercentIncreaseRed": 20,
    "minimumChangeThreshold": 0,
    "showDetails": true
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:ci": "biome check --error-on-warnings .",
    "check": "biome check --write .",
    "check:unsafe": "biome check --write --unsafe .",
    "lint": "biome lint --write .",
    "format": "biome format --write .",
    "prettier": "prettier -w .",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^7.3.7",
    "@mui/material": "^7.3.7",
    "@mui/material-nextjs": "^7.3.7",
    "@mui/system": "^7.3.7",
    "@mui/x-data-grid": "^8.25.0",
    "@sentry/nextjs": "^10.36.0",
    "@types/jest": "^30.0.0",
    "comlink": "^4.4.2",
    "jose": "^6.1.3",
    "js-cookie": "^3.0.5",
    "moment": "^2.30.1",
    "monaco-editor": "^0.55.1",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-error-boundary": "^6.1.0",
    "react-hook-form": "^7.71.1",
    "swr": "^2.3.8",
    "yup": "^1.7.1",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "prettier": "^3.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
