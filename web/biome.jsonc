{
  "$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": false,
    "ignore": []
  },
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 4,
    "lineEnding": "lf",
    "lineWidth": 120,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "ignore": ["**/package.json", "**/package-lock.json", "**/.next/", "**/.swc/"]
  },
  "organizeImports": {
    "enabled": true
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "a11y": {
        "noBlankTarget": "error"
      },
      "complexity": {
        "useArrowFunction": "warn"
      },
      "correctness": {
        "noChildrenProp": "error",
        "noInvalidUseBeforeDeclaration": "off",
        "noUndeclaredDependencies": "error",
        "noUndeclaredVariables": "error",
        "noUnusedImports": "warn",
        "useJsxKeyInIterable": "error",
        "useHookAtTopLevel": "error"
      },
      "nursery": {
        "noImgElement": "error",
        "noIrregularWhitespace": "warn",
        "noNestedTernary": "warn",
        "useCollapsedIf": "warn",
        "useConsistentCurlyBraces": "warn",
        "useExplicitType": "off",
        "useImportRestrictions": "off"
      },
      "security": {
        "all": true
      },
      "style": {
        "noRestrictedGlobals": "error",
        "useBlockStatements": "off",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useDefaultSwitchClause": "warn",
        "useFragmentSyntax": "warn",
        "useNamingConvention": {
          "level": "warn",
          "options": {
            "strictCase": false,
            "requireAscii": true,
            "enumMemberCase": "PascalCase",
            "conventions": [
              {
                "selector": {
                  "kind": "typeLike"
                },
                // Types should be in pascal case, not with IPrefix (though this isn't checked
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "classMember",
                  "modifiers": ["private"]
                },
                "match": "_?(.+)",
                // Private class members in camelCase
                "formats": ["camelCase"]
              },
              {
                "selector": {
                  "kind": "classMember",
                  "modifiers": ["static"]
                },
                // Static class members in PascalCase
                "formats": ["PascalCase"]
              },
              {
                "selector": {
                  "kind": "objectLiteralMember"
                },
                // camelCase is default, sometimes it needs PascalCase for MUI overrides, fe. theme
                "formats": ["PascalCase", "camelCase"]
              },
              {
                "selector": {
                  "kind": "typeProperty"
                },
                // camelCase is default, sometimes it needs PascalCase for MUI overrides, fe. theme
                "formats": ["PascalCase", "camelCase"]
              },
              {
                "selector": {
                  "kind": "const",
                  "scope": "global"
                },
                // Constant values, React.FCs and regular functions
                "formats": ["CONSTANT_CASE", "PascalCase", "camelCase"]
              }
            ]
          }
        },
        "useShorthandArrayType": "warn",
        "useThrowNewError": "warn",
        "useThrowOnlyError": "warn"
      },
      "suspicious": {
        "noCommentText": "error",
        "noConfusingVoidType": "warn",
        "noDuplicateJsxProps": "error",
        "noDebugger": "error",
        "noEvolvingTypes": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "trailingCommas": "all",
      "semicolons": "always",
      "arrowParentheses": "asNeeded",
      "bracketSameLine": false,
      "quoteStyle": "double",
      "attributePosition": "auto",
      "bracketSpacing": true
    },
    "globals": []
  },
  "overrides": [
    {
      "include": ["*.test.js", "*.test.jsx", "*.test.ts", "*.test.tsx"],
      "linter": {
        "rules": {
          "correctness": {
            "noUndeclaredDependencies": "off",
            "noUndeclaredVariables": "off"
          },
          "suspicious": {
            "noEmptyBlockStatements": "off"
          }
        }
      }
    }
  ]
}
