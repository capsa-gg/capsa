#!/bin/bash

# Don't ignore errors
set -e

# Function to build for a specific OS and architecture
build() {
  local os=$1
  local arch=$2
  local output="builds/capsa-${os}-${arch}"

  if [ "$os" = "windows" ]; then
    output="${output}.exe"
  fi

  echo "Building ${output}"

  # GOOS: set operating system
  # GOARCH: set architecture
  # CGO_ENABLED=0: build a statically-linked executable
  # -a: force rebuilding of packages that are already up-to-date
  # -ldflags '-s -w': strip DWARF, symbol table and debug info from binary
  # -o capsa: output build binary to ./capsa
  GOOS=${os} GOARCH=${arch} CGO_ENABLED=0 go build \
    -a \
    -ldflags '-s -w' \
    -o "${output}"
}

# Make sure builds directory exists
mkdir -p builds

# Delete all files in builds directory, if they exist
rm -rf builds/*

# Build for Windows, Linux, and macOS
build linux amd64
build darwin amd64
build windows amd64

echo "Builds completed"
