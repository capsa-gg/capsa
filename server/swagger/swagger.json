                },
                "platform": {
                    "type": "string",
                    "maxLength": 64
                },
                "type": {
                    "description": "Needs manual validation for enum",
                    "type": "string",
                    "maxLength": 32
                }
            }
        },
        "bodies.ClientLogCreationResponse": {
            "type": "object",
            "properties": {
                "expiry": {
                    "type": "string"
                },
                "link_web": {
