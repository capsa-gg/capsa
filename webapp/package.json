{
    "name": "capsa-webpanel",
    "version": "0.0.1",
    "description": "Webapp for Project Capsa, an Unreal Engine log solution",
    "author": "Luciano Nooijen <luciano@lucianonooijen.com>",
    "license": "UNLICENCED",
    "private": true,
    "engines": {
        "node": ">=22.10.0",
        "npm": ">=10.9.0"
    },
    "nextBundleAnalysis": {
        "budget": 1000000,
        "budgetPercentIncreaseRed": 20,
        "minimumChangeThreshold": 0,
        "showDetails": true
    },
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "format": "prettier -w ."
    },
    "dependencies": {
        "next": "15.0.2",
        "react": "19.0.0-rc-02c0e824-20241028",
        "react-dom": "19.0.0-rc-02c0e824-20241028"
    },
    "devDependencies": {
        "@types/node": "^20.17.5",
        "@types/react": "^18.3.12",
        "@types/react-dom": "^18.3.1",
        "eslint": "^8.57.1",
        "eslint-config-next": "^15.0.2",
        "prettier": "^3.3.3",
        "typescript": "^5.6.3"
    }
}
